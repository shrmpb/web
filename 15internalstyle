<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Internal Stylesheet Example</title>
    <style>
        body {
            background-color: #f4f4f4;
            font-family: Arial, sans-serif;
        }
        h1 {
            color: #333333;
            text-align: center;
        }
        p {
            font-size: 16px;
            color: #666666;
        }
    </style>
</head>
<body>
    <h1>Welcome to My Website</h1>
    <p>This paragraph is styled using an internal stylesheet embedded in the head segment.</p>
</body>
</html>
